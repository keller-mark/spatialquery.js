{
  "name": "spatialquery.js",
  "version": "0.1.1",
  "description": "Port of Python SpatialQuery methods (An et al. bioRxiv 2026)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundled": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundled/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@stdlib/stats": "^0.4.1",
    "d3-array": "^2.4.0",
    "flatbush": "^4.4.0",
    "internmap": "^2.0.3",
    "node-fpgrowth": "^1.2.1"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@zarrita/storage": "^0.1.4",
    "anndata.js": "^0.0.3",
    "events": "^3.3.0",
    "hdf5-as-virtual-zarr": "0.1.1",
    "typescript": "^5.8.3",
    "vite": "^7.3.2",
    "vitest": "^3.1.1",
    "zarrita": "^0.7.5"
  }
}
